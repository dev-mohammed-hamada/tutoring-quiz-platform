{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck-before-commit.sh",
            "timeout": 180,
            "statusMessage": "Typechecking before commit"
          }
        ]
      }
    ]
  }
}
