{
  "name": "tutoring-quiz-platform",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": ["shared", "api"],
  "scripts": {
    "start": "node api/dist/index.js",
    "dev": "npm run dev -w api",
    "build": "npm run build -w shared && npm run build -w api",
    "test": "npm run test -w api",
    "migrate": "npm run migrate -w api",
    "seed": "npm run seed -w api"
  }
}
