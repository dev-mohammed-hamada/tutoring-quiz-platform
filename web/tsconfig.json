{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"],
    "resolveJsonModule": true,
    "noEmit": true,
    "declaration": false,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "vite.config.ts"]
}
